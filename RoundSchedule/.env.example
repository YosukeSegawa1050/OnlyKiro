# Copy to .env or run npm run setup:shared to generate a local passphrase.
SCHEDULE_BASE_URL=http://127.0.0.1:8765
SCHEDULE_PASSPHRASE=
SCHEDULE_TIME_ZONE=Asia/Tokyo
SCHEDULE_DATA_DIR=.schedule-data
HOST=127.0.0.1
PORT=8765
