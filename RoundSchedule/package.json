{
  "name": "round-schedule",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.cjs",
    "check": "node --check core.js && node --check storage.js && node --check notifications.js && node --check app.js && node --check ds-sw.js",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write *.js *.css *.html scripts/*.cjs tests/*.cjs",
    "format:check": "prettier --check *.js *.css *.html scripts/*.cjs tests/*.cjs",
    "build": "node scripts/build.cjs"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "linkedom": "0.18.13",
    "prettier": "3.9.6"
  }
}
